[gd_scene load_steps=11 format=3]

; 2.5D combat token: a thin assembly. The billboard sprite, the team ring and the HP bar are their
; own scenes, so any entity can reuse them; this scene only puts them together, adds the name label
; and the Dying badge, and gives the nodes unique names for UnitVisual3D. Everything that varies per unit at runtime
; (sprite sheet and size, team colour, bar and name height) is applied in code by
; UnitVisual3D.Configure/_Ready, so this scene stays a structural skeleton. PickArea is the unit's
; click column (physics layer 2, "Units"); its box is sized in code from the footprint and body.

[ext_resource type="Script" path="res://scripts/combat/UnitVisual3D.cs" id="1_unit"]
[ext_resource type="PackedScene" path="res://scenes/combat/billboard_sprite.tscn" id="2_sprite"]
[ext_resource type="PackedScene" path="res://scenes/combat/team_ring.tscn" id="3_ring"]
[ext_resource type="PackedScene" path="res://scenes/combat/world_hp_bar.tscn" id="4_hpbar"]
[ext_resource type="Script" path="res://scripts/combat/UnitPickArea.cs" id="5_pick"]

[ext_resource type="Script" path="res://scripts/combat/DyingBadge.cs" id="6_dying"]
[ext_resource type="Resource" path="res://assets/ui/conditions/condition_icons.tres" id="7_icons"]
[ext_resource type="Script" path="res://scripts/combat/NamePlate3D.cs" id="8_plate"]
[ext_resource type="FontFile" uid="uid://bxrrn1mpgddao" path="res://assets/fonts/pixeloid/PixeloidSans-Bold.ttf" id="9_bold"]
[ext_resource type="PackedScene" path="res://scenes/combat/active_crystal.tscn" id="10_crystal"]

