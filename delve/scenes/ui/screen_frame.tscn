[node name="HeaderSlot" type="HBoxContainer" parent="Frame/Box/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8

[node name="FrameTabs" type="HBoxContainer" parent="Frame/Box/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8

[node name="HeaderSpacer" type="Control" parent="Frame/Box/Header"]
layout_mode = 2
