[node name="Combat" type="Node3D"]
script = ExtResource("1_scene")

; The board's ground as one component: it owns the generated terrain view, the biome backdrop and
; the flat placeholder floor below, and CombatScene builds all three through its single Build call.
[node name="TerrainStage" type="Node3D" parent="."]
unique_name_in_owner = true
script = ExtResource("14_terrain")
PlaceholderFloorPath = NodePath("PlaceholderFloor")
HaloTreeScenes = [ExtResource("15_tree_canopy"), ExtResource("16_tree_conifer"), ExtResource("17_tree_bush"), ExtResource("18_tree_dead"), ExtResource("19_tree_giant")]
HaloTreeWeights = [3.0, 3.0, 1.5, 0.8, 0.2]
HaloTreeMinRings = [4.0, 4.0, 0.0, 4.0, 6.0]
BoardTreeScenes = [ExtResource("15_tree_canopy"), ExtResource("16_tree_conifer")]
BoardTreeWeights = [3.0, 2.0]

