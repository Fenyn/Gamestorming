[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/select/duelist_select.gd" id="1_select"]
[ext_resource type="PackedScene" path="res://scenes/select/select_seat.tscn" id="2_seat"]
[ext_resource type="PackedScene" path="res://scenes/duel/card_face_cache.tscn" id="3_faces"]
[ext_resource type="Script" path="res://scripts/ui/arcane_backdrop.gd" id="4_atmosphere"]

[node name="DuelistSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.05, 0.055, 1)
script = ExtResource("4_atmosphere")

[node name="CardFaceCache" parent="." instance=ExtResource("3_faces")]

[node name="Tick" type="Timer" parent="."]
wait_time = 0.25

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 28

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleRow" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Back" type="Button" parent="Margin/Column/TitleRow"]
custom_minimum_size = Vector2(120, 54)
layout_mode = 2
size_flags_vertical = 4
text = "Back"

[node name="Title" type="Label" parent="Margin/Column/TitleRow"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HeaderLabel"
text = "Choose your duelist"

[node name="Spacer" type="Control" parent="Margin/Column/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Players" type="HBoxContainer" parent="Margin/Column/TitleRow"]
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8

[node name="PlayersTag" type="Label" parent="Margin/Column/TitleRow/Players"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "PLAYERS"

[node name="Seat0" type="PanelContainer" parent="Margin/Column/TitleRow/Players"]
custom_minimum_size = Vector2(216, 0)
layout_mode = 2

[node name="Label" type="Label" parent="Margin/Column/TitleRow/Players/Seat0"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "P1  Player 1"
horizontal_alignment = 1

[node name="Seat1" type="PanelContainer" parent="Margin/Column/TitleRow/Players"]
custom_minimum_size = Vector2(216, 0)
layout_mode = 2

[node name="Label" type="Label" parent="Margin/Column/TitleRow/Players/Seat1"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "P2  waiting"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Margin/Column/TitleRow"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MutedLabel"
text = ""
horizontal_alignment = 2

[node name="CodeBanner" type="PanelContainer" parent="Margin/Column"]
visible = false
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Margin/Column/CodeBanner"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="Lead" type="Label" parent="Margin/Column/CodeBanner/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"BodyLabel"
text = "Waiting for a player to join. Share this room code:"

[node name="Code" type="Label" parent="Margin/Column/CodeBanner/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"TitleLabel"
text = "XXXXX"

[node name="Copy" type="Button" parent="Margin/Column/CodeBanner/Row"]
layout_mode = 2
size_flags_vertical = 4
text = "Copy"

[node name="Copied" type="Label" parent="Margin/Column/CodeBanner/Row"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MutedLabel"
text = "on your clipboard"

[node name="Subtitle" type="Label" parent="Margin/Column"]
visible = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "THE CONTEST OF EIDOLARCHS     /     Choose the power you will bring to the arena"

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 28

[node name="Library" type="VBoxContainer" parent="Margin/Column/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Tools" type="HBoxContainer" parent="Margin/Column/Body/Library"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Search" type="LineEdit" parent="Margin/Column/Body/Library/Tools"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Search decks, duelists, or playstyles"
clear_button_enabled = true

[node name="School" type="OptionButton" parent="Margin/Column/Body/Library/Tools"]
custom_minimum_size = Vector2(185, 48)
layout_mode = 2

[node name="Count" type="Label" parent="Margin/Column/Body/Library"]
visible = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "STARTER DECKS"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column/Body/Library"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Roster" type="GridContainer" parent="Margin/Column/Body/Library/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

[node name="Empty" type="Label" parent="Margin/Column/Body/Library"]
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "No matching decks. Try another name or school."

[node name="Reset" type="Button" parent="Margin/Column/Body/Library"]
visible = false
layout_mode = 2
size_flags_horizontal = 0
text = "Clear filters"

[node name="Help" type="Label" parent="Margin/Column/Body/Library"]
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Browse with arrow keys   /   Enter to select a deck   /   Confirm when ready"

[node name="Seat" parent="Margin/Column/Body" instance=ExtResource("2_seat")]
custom_minimum_size = Vector2(1050, 0)
layout_mode = 2
size_flags_horizontal = 0
