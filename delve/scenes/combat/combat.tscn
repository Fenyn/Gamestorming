[sub_resource type="PlaneMesh" id="PlaneMesh_floor"]
size = Vector2(12, 10)

[sub_resource type="Shader" id="Shader_floor"]
code = "shader_type spatial;
render_mode cull_disabled;

uniform vec3 color_a : source_color = vec3(0.17, 0.18, 0.22);
uniform vec3 color_b : source_color = vec3(0.12, 0.13, 0.16);
uniform vec3 line_color : source_color = vec3(0.30, 0.32, 0.38);

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float checker = mod(floor(world_pos.x) + floor(world_pos.z), 2.0);
	vec3 col = mix(color_a, color_b, checker);
	vec2 f = fract(world_pos.xz);
	float line = step(f.x, 0.03) + step(0.97, f.x) + step(f.y, 0.03) + step(0.97, f.y);
	col = mix(col, line_color, clamp(line, 0.0, 1.0) * 0.5);
	ALBEDO = col;
	ROUGHNESS = 1.0;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_floor"]
render_priority = 0
