[ext_resource type="Script" path="res://resources/milestone_data.gd" id="1"]

[resource]
script = ExtResource("1")
milestone_id = "directive_1"
directive_number = 1
display_name = "FIRST HARVEST"
ai_message = "I've been watching the crew ration what we brought from Earth, and it won't last. I need you to get those chambers producing — real food, enough to feed everyone. Fifty units will give us breathing room. You can do this."
required_food_units = 50
unlocked_crops = ["tomato", "pepper", "cotton", "prickly_pear"]
unlocked_modules = ["processing_lab", "grow_ring_b"]
unlocked_story_entries = ["log_crop_guide", "log_maintenance_1"]
lore_hint = "New seed varieties released from the Hermes supply kit. The Engineer has restored power to the Workshop and a second grow chamber."
