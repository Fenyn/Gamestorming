[node name="PromotionSummary" type="Label" parent="Margin/Columns/Rail"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ScreenHint"
autowrap_mode = 3

[node name="Ladder" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
