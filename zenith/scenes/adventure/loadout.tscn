[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/adventure/loadout.gd" id="1_loadout"]
[ext_resource type="PackedScene" path="res://scenes/duel/card_face_cache.tscn" id="2_faces"]
[ext_resource type="PackedScene" path="res://scenes/adventure/run_deck_list.tscn" id="3_list"]
[ext_resource type="PackedScene" path="res://scenes/ui/stat_tile.tscn" id="4_tile"]

[node name="Loadout" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_loadout")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.05, 0.055, 1)

[node name="CardFaceCache" parent="." instance=ExtResource("2_faces")]

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleRow" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Column/TitleRow"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HeaderLabel"
text = "Loadout"

[node name="DeckName" type="Label" parent="Margin/Column/TitleRow"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"BodyLabel"
text = ""

[node name="Upgrades" type="PanelContainer" parent="Margin/Column"]
layout_mode = 2

[node name="UpgradeRow" type="HBoxContainer" parent="Margin/Column/Upgrades"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Motes" parent="Margin/Column/Upgrades/UpgradeRow" instance=ExtResource("4_tile")]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4

[node name="SlotBox" type="VBoxContainer" parent="Margin/Column/Upgrades/UpgradeRow"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="SlotLabel" type="Label" parent="Margin/Column/Upgrades/UpgradeRow/SlotBox"]
layout_mode = 2
text = "Deck slots"

[node name="BuySlot" type="Button" parent="Margin/Column/Upgrades/UpgradeRow/SlotBox"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
disabled = true
text = "Buy deck slot"

[node name="UpgradeStatus" type="Label" parent="Margin/Column/Upgrades/UpgradeRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"MutedLabel"
text = ""
autowrap_mode = 3

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Left" type="VBoxContainer" parent="Margin/Column/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.3
theme_override_constants/separation = 10

[node name="Header" type="Label" parent="Margin/Column/Body/Left"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "STARTER DECK"

[node name="RungRow" type="HFlowContainer" parent="Margin/Column/Body/Left"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6

[node name="DeckList" parent="Margin/Column/Body/Left" instance=ExtResource("3_list")]
layout_mode = 2
size_flags_vertical = 3
show_copies = true

[node name="DeckStatus" type="HBoxContainer" parent="Margin/Column/Body/Left"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="DeckSize" type="Label" parent="Margin/Column/Body/Left/DeckStatus"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
