; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Green Bean"
config/description="A tactile first-person barista simulator with online multiplayer. Ring up orders, print tickets, and assemble drinks by hand."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
UnlockManager="*res://scripts/autoload/unlock_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
StationUtils="*res://scripts/autoload/station_utils.gd"
SoundManager="*res://scripts/autoload/sound_manager.gd"
Fx="*res://scripts/autoload/fx.gd"
GameSettings="*res://scripts/autoload/game_settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Green Bean"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_base/plugin.cfg")

[global_group]

world_label=""

[gui]

theme/custom="res://assets/ui/ui_theme.tres"

