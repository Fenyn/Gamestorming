[gd_scene load_steps=5 format=3]

; 2.5D combat token: a thin assembly. The billboard sprite, the team ring and the HP bar are their
; own scenes, so any entity can reuse them; this scene only puts them together, adds the name label,
; and gives the four nodes unique names for UnitVisual3D. Everything that varies per unit at runtime
; (sprite sheet and size, team colour, bar and name height) is applied in code by
; UnitVisual3D.Configure/_Ready, so this scene stays a structural skeleton.

[ext_resource type="Script" path="res://scripts/combat/UnitVisual3D.cs" id="1_unit"]
[ext_resource type="PackedScene" path="res://scenes/combat/billboard_sprite.tscn" id="2_sprite"]
[ext_resource type="PackedScene" path="res://scenes/combat/team_ring.tscn" id="3_ring"]
[ext_resource type="PackedScene" path="res://scenes/combat/world_hp_bar.tscn" id="4_hpbar"]

[node name="UnitToken" type="Node3D"]
script = ExtResource("1_unit")

[node name="Sprite" parent="." instance=ExtResource("2_sprite")]
unique_name_in_owner = true

[node name="Ring" parent="." instance=ExtResource("3_ring")]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, 0)

[node name="HpBar" parent="." instance=ExtResource("4_hpbar")]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)

[node name="Name" type="Label3D" parent="."]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.22, 0)
pixel_size = 0.005
billboard = 1
no_depth_test = true
font_size = 48
outline_size = 8
outline_modulate = Color(0, 0, 0, 1)
