[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/flow/PromotionPanel.cs" id="script"]
[ext_resource type="PackedScene" path="res://scenes/run/promotion_feat_card.tscn" id="card"]

[node name="Progression" type="PanelContainer"]
theme_type_variation = &"SheetPanel"
script = ExtResource("script")
CardScene = ExtResource("card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="PromotionHeading" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"

[node name="PromotionSummary" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="FeatTree" type="GridContainer" parent="Margin/Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
columns = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

[node name="FeatPreview" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
autowrap_mode = 2

[node name="ConfirmPromotion" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Confirm promotion"
disabled = true

[node name="SaveFeatChoice" type="Button" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Keep feat choice"
visible = false
