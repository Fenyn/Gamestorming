[node name="Header" type="Label" parent="Margin/Column/Body/Right"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "COLLECTION"

[node name="SwapHint" type="Label" parent="Margin/Column/Body/Right"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Pick a deck card or a Duelist rung to see what could swap in"
