[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/flow/SheetSection.cs" id="1_section"]
[ext_resource type="PackedScene" path="res://scenes/ui/item_icon_entry.tscn" id="2_item"]
[ext_resource type="Resource" path="res://assets/ui/item_icons.tres" id="3_icons"]

[node name="SheetSection" type="VBoxContainer"]
theme_override_constants/separation = 6
script = ExtResource("1_section")
ItemEntryScene = ExtResource("2_item")
ItemIcons = ExtResource("3_icons")

[node name="HeadingBand" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Glyph" type="Label" parent="HeadingBand"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "◆"
theme_type_variation = &"TipTag"

[node name="SectionHeading" type="Label" parent="HeadingBand"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "SECTION"
theme_type_variation = &"RowLabel"

[node name="Rule" type="Panel" parent="HeadingBand"]
custom_minimum_size = Vector2(24, 1)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"RuleLine"

[node name="SectionItems" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
