[ext_resource type="PackedScene" path="res://scenes/select/select_seat.tscn" id="2_seat"]
[ext_resource type="PackedScene" path="res://scenes/duel/card_face_cache.tscn" id="3_faces"]

[node name="DuelistSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.055, 0.07, 1)

[node name="CardFaceCache" parent="." instance=ExtResource("3_faces")]

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
