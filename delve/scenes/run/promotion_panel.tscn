[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/flow/PromotionPanel.cs" id="script"]
[ext_resource type="PackedScene" path="res://scenes/run/promotion_feat_card.tscn" id="card"]
[ext_resource type="PackedScene" path="res://scenes/ui/figure_label.tscn" id="figure"]

[node name="Progression" type="PanelContainer"]
theme_type_variation = &"SheetPanel"
script = ExtResource("script")
CardScene = ExtResource("card")
FigureScene = ExtResource("figure")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Columns" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="Rail" type="VBoxContainer" parent="Margin/Columns"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="Plinth" type="PanelContainer" parent="Margin/Columns/Rail"]
custom_minimum_size = Vector2(320, 240)
layout_mode = 2
theme_type_variation = &"BestiaryPlinth"

[node name="PromotionPortrait" type="TextureRect" parent="Margin/Columns/Rail/Plinth"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
mouse_filter = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 0

[node name="PromotionHeading" type="Label" parent="Margin/Columns/Rail"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
autowrap_mode = 3

[node name="PromotionIdentity" type="Label" parent="Margin/Columns/Rail"]
