[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/comms_panel.gd" id="1_comms"]

[node name="CommsPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -150.0
offset_right = 200.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_comms")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "COMMUNICATIONS"
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "No contacts available.

Contacts will appear as you
progress through directives."
horizontal_alignment = 1
modulate = Color(0.5, 0.5, 0.6, 1)

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="CloseHint" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "[Esc] Close"
horizontal_alignment = 1
modulate = Color(0.5, 0.5, 0.6, 1)
